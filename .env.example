# Copiá este archivo como ".env" y completá tus claves.
# El .env real NUNCA se sube a GitHub (está en .gitignore).

# --- Redis ---
# Con Docker Compose, la API se conecta al servicio "redis" (docker-compose.yml
# ya pisa este valor). Si corrés la API fuera de Docker, usá localhost.
REDIS_URL=redis://localhost:6379

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Observabilidad (LangSmith) ---
# Creá una API key en https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=preentrega7-orquestador
# Si tu cuenta está en la región EU, descomentá:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Worker ---
TIMEOUT_JOB_SEGUNDOS=300
LOG_LEVEL=INFO
